© 1 if vl_col1 in df.columns: side1 = df[df[vl_col1] == vl_id] if not side1.empty and node_col1 in side1.columns: for eq_id, row in side1.iterrows(): node = int(row[node_col1]) ensure_node(G, node)
© 2 if vl_col2 in df.columns: side2 = df[df[vl_col2] == vl_id] if not side2.empty and node_col2 in side2.columns: for eq_id, row in side2.iterrows(): node = int(row[node_col2]) ensure_node(G, node) </text>

