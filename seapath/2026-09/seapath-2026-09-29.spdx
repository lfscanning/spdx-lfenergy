##File

FileName: seapath-2026-09-29.zip/yocto-bsp/tools/check_license.sh
SPDXID: SPDXRef-item15390947
FileChecksum: SHA1: 501b47435704d388f1faa0f3bbc3e57e77dad047
FileChecksum: SHA256: 10225dfbb46c0132fdc230db9e17553e5a92026ccbe4b46355f9b81cbe7f0dbb
FileChecksum: MD5: 0e97a1d952eac393cbc90074ae322d5f
LicenseConcluded: Apache-2.0
LicenseInfoInFile: Apache-2.0
FileCopyrightText: <text> Copyright (C) 2020, RTE (http://www.rte-france.com) SPDX-License-Identifier: Apache-2.0
copyright() { local dir=$1
copyright on $yocto_project" file_extension=".*\.\(adoc\|bb\|bbappend\|inc\|c\|cpp\|md\|py\|sh\|toml\|xml\)"
copyright" find $dir -type f -regex "$file_extension" \ exec grep --color=auto -iHnL "$search_name" {} \;; echo "############################"
copyright . && check_license . go_to_working_dir || exit 1 done cd $current_pwd </text>

